{
  "manifest_version": 3,
  "name": "电商商品信息提取器",
  "version": "1.0.0",
  "description": "提取天猫和京东商品详情页的关键信息，支持AI分析和多格式导出",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel"],
  "host_permissions": [
    "https://*.tmall.com/*",
    "https://*.jd.com/*",
    "https://*.jd.hk/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://qianfan.baidubce.com/*",
    "https://api.minimax.chat/*",
    "https://api.openai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tmall.com/*", "https://*.jd.com/*", "https://*.jd.hk/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "商品信息提取器"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["help.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
